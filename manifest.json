{
  "id": "com.example.autorecap",
  "name": "AutoRecap",
  "version": "2.0.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": {
    "app": "premierepro",
    "minVersion": "26.0.2",
    "data": { "apiVersion": 2 }
  },
  "permissions": {
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": { "default": "AutoRecap" },
      "main": "index.html",
      "minimumSize": { "width": 280, "height": 400 },
      "preferredDockedSize": { "width": 360, "height": 600 },
      "maximumSize": { "width": 2000, "height": 2000 }
    }
  ]
}
