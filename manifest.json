{
  "id": "com.example.premiere-simple-panel",
  "name": "Simple Panel",
  "version": "1.0.0",
  "manifestVersion": 5,
  "host": [
    {
      "app": "PPRO",
      "minVersion": "22.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": { "default": "Simple Panel" },
      "main": "index.html",
      "minimumSize": { "width": 200, "height": 120 },
      "preferredDockedSize": { "width": 300, "height": 300 },
      "maximumSize": { "width": 2000, "height": 2000 }
    }
  ]
}
